# The server rejects any non-loopback host in Personal Mode.
MODELS_ROUNDTABLE_HOST=127.0.0.1
MODELS_ROUNDTABLE_PORT=4317

# Optional development-only location. Keep this outside the repository in normal use.
# MODELS_ROUNDTABLE_DATA_DIR=C:\path\to\local\app-data

# Optional, explicit workspace for the read-only Codex agent. Must be absolute.
# MODELS_ROUNDTABLE_CODEX_WORKSPACE=C:\path\to\a\project
